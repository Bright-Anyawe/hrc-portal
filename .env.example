# ---- Database (Prisma CLI / migrations) ----
# Local Prisma Postgres dev instance URL (used by `prisma migrate`/`prisma db seed`).
# For production, set this to your managed PostgreSQL connection string.
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=REPLACE_ME"

# Direct TCP connection used by the runtime Prisma Client (pg driver adapter).
# Local dev: local Prisma Postgres instance. Production: managed Postgres URL.
DIRECT_DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ---- Auth ----
# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="REPLACE_ME"

# ---- Google OAuth (Sign in with Google) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Portal ----
# Public base URL, used in invitation emails.
PORTAL_URL="http://localhost:3000"

# ---- Email (optional - invitations fall back to console logs in dev) ----
SMTP_HOST=""          # e.g. smtp.postmarkapp.com
SMTP_PORT="587"
SMTP_SECURE="false"   # true for port 465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="HRC Portal <no-reply@hrc.local>"

# ---- Paystack (online payments) ----
# Server-side secret key. Test mode: sk_test_... / Live mode: sk_live_...
# Get keys at https://dashboard.paystack.com/#/settings/developers
# Switching test <-> live is just swapping this key.
PAYSTACK_SECRET_KEY=""
# Public key (pk_test_... / pk_live_...). ONLY required if you switch the
# checkout to Paystack's inline/popup integration. The current implementation
# uses the server-initiated redirect flow, so the public key is not read by the app.
PAYSTACK_PUBLIC_KEY=""
# Currency invoices are billed in. Paystack charges in the currency's smallest
# unit (cents for USD, kobo for NGN, pesewas for GHS). Defaults to "USD".
PAYSTACK_CURRENCY="USD"
